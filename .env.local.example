# Supabase
# Project Settings -> API in your Supabase dashboard

# Safe to expose in browser code
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. Never prefix with NEXT_PUBLIC_, never commit real value.
SUPABASE_SERVICE_ROLE_KEY=

# Claude AI (Anthropic)
# console.anthropic.com -> API Keys
# Server-only secret.
ANTHROPIC_API_KEY=
# Optional - defaults to a current Claude model in code if unset
ANTHROPIC_MODEL=
